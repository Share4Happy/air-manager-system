# Sao chép file này thành .env.production rồi điền giá trị thật.
#   cp .env.production.sample .env.production
# File .env.production bị .dockerignore chặn (không vào image) và không commit.

# === Kết nối & bảo mật ===
MONGODB_URI=mongodb+srv://<user>:<pass>@<host>/air
JWT_SECRET=<secret>
token=sys1
URL=http://localhost:4000/

# === Google Drive service account (bắt buộc để gọi Drive) ===
GOOGLE_PROJECT_ID=<project-id>
GOOGLE_CLIENT_EMAIL=<sa>@<project>.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----\n'

# === Drive folder ids ===
DRIVE_COURSE_FOLDER_ID=<folder-id>
DRIVE_AVT_FOLDER_ID=<folder-id>
DRIVE_COURSE_IMAGE_FOLDER_ID=<folder-id>

# === Tuỳ chọn: URL hiển thị / e-portfolio (fallback có sẵn trong code) ===
NEXT_PUBLIC_URL=http://localhost:4000/
NEXT_PUBLIC_EPORTFOLIO_URL=http://localhost:3001
NEXT_PUBLIC_DRIVE_IMAGE_URL=https://lh3.googleusercontent.com/d/
NEXT_PUBLIC_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/
NEXT_PUBLIC_DRIVE_THUMBNAIL_URL=https://drive.google.com/thumbnail?id=
NEXT_PUBLIC_DRIVE_PREVIEW_URL=https://drive.google.com/file/d/
NEXT_PUBLIC_DRIVE_DOWNLOAD_URL=https://drive.google.com/uc?export=download&id=
NEXT_PUBLIC_DRIVE_DEFAULT_AVATAR_ID=<file-id>

# === Tuỳ chọn: ZaloLite (mặc định đọc từ DB qua Cài đặt -> tab ZaloLite) ===
# ZALOLITE_BASE_URL=https://sms-service.talab.io.vn/api/gateway/v1.0
# ZALOLITE_API_KEY=zlite_...
